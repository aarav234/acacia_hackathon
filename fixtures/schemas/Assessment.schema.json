{
  "$defs": {
    "Plan": {
      "additionalProperties": false,
      "properties": {
        "gate_id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Gate Id",
          "type": "string"
        },
        "gate_in_min": {
          "title": "Gate In Min",
          "type": "integer"
        },
        "landing_min": {
          "minimum": 0,
          "title": "Landing Min",
          "type": "integer"
        },
        "plan_id": {
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Plan Id",
          "type": "string"
        },
        "runway_id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Runway Id",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Scenario Id",
          "type": "string"
        },
        "service_end_min": {
          "title": "Service End Min",
          "type": "integer"
        },
        "state_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Hash",
          "type": "string"
        },
        "taxi_min": {
          "exclusiveMinimum": 0,
          "title": "Taxi Min",
          "type": "integer"
        },
        "taxi_route_id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Taxi Route Id",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "scenario_id",
        "state_hash",
        "landing_min",
        "runway_id",
        "gate_id",
        "taxi_route_id",
        "taxi_min",
        "gate_in_min",
        "service_end_min"
      ],
      "title": "Plan",
      "type": "object"
    },
    "ValidationReport": {
      "additionalProperties": false,
      "properties": {
        "feasible": {
          "title": "Feasible",
          "type": "boolean"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "plan_id": {
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Plan Id",
          "type": "string"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/Violation"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "plan_id",
        "feasible",
        "violations",
        "metrics"
      ],
      "title": "ValidationReport",
      "type": "object"
    },
    "Violation": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "pattern": "^[a-z]+:[A-Za-z0-9_.\\[\\]-]+$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "observed": {
          "title": "Observed",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Rule Id",
          "type": "string"
        },
        "units": {
          "title": "Units",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "reason",
        "observed",
        "required",
        "units",
        "evidence_ids"
      ],
      "title": "Violation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "components": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "number"
        },
        "type": "object"
      },
      "propertyNames": {
        "enum": [
          "atc",
          "pilot",
          "ground"
        ]
      },
      "title": "Components",
      "type": "object"
    },
    "plan": {
      "$ref": "#/$defs/Plan"
    },
    "utilities": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "enum": [
          "atc",
          "pilot",
          "ground"
        ]
      },
      "title": "Utilities",
      "type": "object"
    },
    "validation": {
      "$ref": "#/$defs/ValidationReport"
    }
  },
  "required": [
    "plan",
    "validation",
    "utilities",
    "components"
  ],
  "title": "Assessment",
  "type": "object"
}
