{
  "$defs": {
    "LogEvent": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "event_type": {
          "title": "Event Type",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "round": {
          "maximum": 2,
          "minimum": 0,
          "title": "Round",
          "type": "integer"
        },
        "scenario_id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Scenario Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "state_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Hash",
          "type": "string"
        },
        "timestamp_utc": {
          "title": "Timestamp Utc",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "timestamp_utc",
        "scenario_id",
        "state_hash",
        "round",
        "actor",
        "event_type",
        "payload"
      ],
      "title": "LogEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_message_count": {
      "maximum": 6,
      "minimum": 0,
      "title": "Agent Message Count",
      "type": "integer"
    },
    "elapsed_ms": {
      "minimum": 0,
      "title": "Elapsed Ms",
      "type": "number"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/LogEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "fallback_plan_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fallback Plan Id"
    },
    "human_approval_required": {
      "const": true,
      "title": "Human Approval Required",
      "type": "boolean"
    },
    "provider_mode": {
      "enum": [
        "live",
        "mock",
        "replay"
      ],
      "title": "Provider Mode",
      "type": "string"
    },
    "reason_code": {
      "title": "Reason Code",
      "type": "string"
    },
    "rounds_completed": {
      "maximum": 2,
      "minimum": 0,
      "title": "Rounds Completed",
      "type": "integer"
    },
    "scenario_id": {
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_plan_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Plan Id"
    },
    "state_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "State Hash",
      "type": "string"
    },
    "status": {
      "enum": [
        "consensus",
        "fallback",
        "human_review"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "state_hash",
    "status",
    "reason_code",
    "selected_plan_id",
    "fallback_plan_id",
    "rounds_completed",
    "agent_message_count",
    "provider_mode",
    "events",
    "elapsed_ms",
    "human_approval_required"
  ],
  "title": "RunResult",
  "type": "object"
}
